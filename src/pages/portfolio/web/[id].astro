---
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import Layout from "@/layouts/Layout.astro";
import { RiArrowLeftLine } from "@remixicon/react";
import { Image } from "astro:assets";
import { render, getCollection, getEntry } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const webs = await getCollection("web");

  return webs.map((web) => {
    return {
      params: {
        id: web.id,
      },
      props: {
        web,
      },
    };
  });
}

let { web } = Astro.props;
const { id } = Astro.params;

if (!web && id) {
  const entry = await getEntry("web", id);
  if (entry) {
    web = entry;
  }
}

if (!web) {
  return Astro.redirect("/404");
}

const { Content } = await render(web);

const dateRaw = web.data.Date ?? "";

const formattedDate = new Date(dateRaw).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
});
---

<Layout
  type="article"
  article={{
    publishedTime: dateRaw ? new Date(dateRaw).toISOString() : "",
    author: "Eyad Farah",
    section: web.data.Protype,
    tags: web.data.stack,
  }}
  title={`${web.data.title} | Web Portfolio`}
  description={web.data.description}
>
  <main class="max-w-7xl mx-auto px-6 md:px-0 pt-32 pb-20">
    <!-- Back Navigation -->
    <a
      href="/portfolio/web"
      class="inline-flex items-center gap-2 mb-12 group font-mono text-[11px] tracking-[0.2em] uppercase text-white/30 hover:text-primary transition-colors"
    >
      <RiArrowLeftLine
        className="group-hover:-translate-x-1 transition-transform"
      />
      Back to Gallery
    </a>

    <!-- Bento Grid Layout -->
    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <!-- Sticky Sidebar (Details) -->
      <aside class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col gap-8">
        <div class="bg-white/3 rounded-4xl p-8 border border-white/5">
          <div class="flex flex-wrap gap-2 mb-6">
            <span
              class="px-3 py-1 rounded-full bg-primary text-black font-mono text-[9px] uppercase tracking-widest"
              >{web.data.Protype}</span
            >
          </div>

          <h1 class="font-bebas uppercase text-6xl leading-[0.9] mb-6">
            {web.data.title}<span class="text-primary">.</span>
          </h1>
          <p class="text-white/50 leading-relaxed text-sm mb-8">
            {web.data.description}
          </p>

          <!-- Tech Stack Section -->
          <div class="mb-8">
            <h3
              class="text-white/20 font-mono text-[9px] uppercase tracking-widest mb-4"
            >
              Tech Stack
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                web.data.stack.map((skill: string) => (
                  <span class="px-3 py-1 rounded-lg bg-white/5 border border-white/5 text-[10px] font-mono text-white/60">
                    {skill}
                  </span>
                ))
              }
            </div>
          </div>

          <div
            class="pt-6 border-t border-white/5 flex justify-between items-center"
          >
            <span class="font-mono text-[10px] uppercase text-white/20"
              >{formattedDate}</span
            >
            <PrimaryBtn
              target={true}
              link={web.data.website ?? "#"}
              text="Launch Site"
            />
          </div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <section class="lg:col-span-8 flex flex-col gap-8">
        <!-- Hero Thumbnail -->
        <div
          class="rounded-4xl overflow-hidden border border-white/5 bg-black/50"
        >
          <Image
            src={web.data.thumbnail}
            widths={[800, 1200]}
            sizes="(max-width: 1024px) 100vw, 800px"
            width={1200}
            height={900}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto object-cover"
            alt={web.data.title}
          />
        </div>

        <!-- Markdown Content -->
        <div
          class="rounded-4xl overflow-hidden border border-white/5 bg-neutral-900/20"
        >
          <div
            class="prose prose-invert prose-lg max-w-none
                      prose-headings:font-bebas prose-img:m-0 prose-headings:uppercase"
          >
            <Content />
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
