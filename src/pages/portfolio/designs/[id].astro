---
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import Layout from "@/layouts/Layout.astro";
import { RiArrowLeftLine } from "@remixicon/react";
import { Image } from "astro:assets";
import { getEntry, render, getCollection } from "astro:content";

export const prerender = true

export async function getStaticPaths() {
  const designs = await getCollection("design");

  return designs.map((design) => {
    return {
      params: {
        id: design.id,
      },
      props: {
        design,
      },
    };
  });
}

let { design } = Astro.props;
const { id } = Astro.params;

if (!design && id) {
  const entry = await getEntry("design", id);
  if (entry) {
    design = entry;
  }
}

if (!design) {
  return Astro.redirect("/404");
}

const { Content } = await render(design);

const dateRaw = design.data.Date ?? "";

const year = new Date(design.data.Date).getFullYear();
const shortDate = new Date(design.data.Date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
});
---

<Layout
  type="article"
  article={{
    publishedTime: dateRaw ? new Date(dateRaw).toISOString() : "",
    author: "Eyad Farah",
    section: design.data.Protype,
  }}
  title={design.data.title + " | design Design"}
  description={design.data.description}
>
  <article class="max-w-7xl mx-auto px-6 md:px-10 lg:px-0 pt-32 pb-20">
    <a
      href="/portfolio/designs"
      class="inline-flex items-center gap-2 mb-12 font-mono text-[11px] tracking-[0.14em] uppercase text-white/30 hover:text-primary transition-colors duration-200"
    >
      <RiArrowLeftLine />
      All designs
    </a>

    {/* ── Bento header ─────────────────────────────────────────────── */}
    <div
      class="relative overflow-hidden rounded-[2.5rem] border border-white/[0.07] bg-neutral-900/30 grid lg:grid-cols-12 mb-3"
    >
      {/* Left — thumbnail */}
      <div
        class="lg:col-span-5 p-5 md:p-7 border-b lg:border-b-0 lg:border-r border-white/[0.07]"
      >
        <div
          class="relative w-full aspect-square rounded-4xl overflow-hidden border border-white/[0.07] bg-black/50"
        >
          <Image
            src={design.data.thumbnail}
            width={1600}
            height={1600}
            loading={"eager"}
            class="object-cover"
            alt={design.data.title}
            priority
          />
        </div>
      </div>

      {/* Right — details */}
      <div
        class="lg:col-span-7 p-8 md:p-12 flex flex-col justify-between gap-10"
      >
        {/* Top block */}
        <div class="flex flex-col gap-8">
          {/* Badges + year */}
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="px-4 py-1.5 rounded-full bg-primary text-black font-mono text-[10px] tracking-[0.15em] uppercase"
            >
              {design.data.Protype}
            </span>

            {
              design.data.Unofficial && (
                <span class="px-4 py-1.5 rounded-full border border-primary/40 text-primary font-mono text-[10px] tracking-[0.15em] uppercase">
                  Unofficial
                </span>
              )
            }

            <span
              class="font-mono text-[11px] tracking-[0.14em] uppercase text-white/25 ml-auto"
            >
              {year}
            </span>
          </div>

          {/* Title */}
          <h1
            class="font-['Bebas_Neue',sans-serif] uppercase text-[clamp(52px,8vw,112px)] leading-[0.85] tracking-[-0.01em]"
          >
            {design.data.title}
            <span class="text-primary">.</span>
          </h1>

          {/* Overview */}
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-4">
              <span
                class="font-mono text-[10px] tracking-[0.18em] uppercase text-primary"
              >
                Overview
              </span>
              <span class="flex-1 h-px bg-white/6"></span>
            </div>
            <p class="text-[16px] text-white/45 leading-[1.8] max-w-xl">
              {design.data.description}
            </p>
          </div>
        </div>

        {/* Bottom — date + CTA */}
        <div
          class="flex items-center justify-between gap-6 flex-wrap pt-8 border-t border-white/6"
        >
          <span
            class="font-mono text-[10px] tracking-[0.15em] uppercase text-white/25"
          >
            {shortDate}
          </span>
          <PrimaryBtn
            target={true}
            link={`${design.data.website}`}
            text="View on Behance"
          />
        </div>
      </div>
    </div>

    <section
      class="overflow-hidden rounded-[2.5rem] border border-white/[0.07] bg-neutral-900/30"
    >
      <Content
        class="prose prose-invert prose-lg max-w-none prose-headings:font-['Bebas_Neue',sans-serif] prose-headings:uppercase prose-headings:tracking-[-0.01em] prose-headings:leading-[0.9] prose-p:text-white/45 prose-p:leading-loose prose-img:m-0 prose-img:w-full"
      />
    </section>
  </article>
</Layout>
