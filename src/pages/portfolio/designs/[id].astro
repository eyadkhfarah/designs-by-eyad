---
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import Layout from "@/layouts/Layout.astro";
import { RiArrowLeftLine } from "@remixicon/react";
import { Image } from "astro:assets";
import { getEntry, render, getCollection } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const designs = await getCollection("design");

  return designs.map((design) => {
    return {
      params: {
        id: design.id,
      },
      props: {
        design,
      },
    };
  });
}

let { design } = Astro.props;
const { id } = Astro.params;

if (!design && id) {
  const entry = await getEntry("design", id);
  if (entry) {
    design = entry;
  }
}

if (!design) {
  return Astro.redirect("/404");
}

const { Content } = await render(design);

const dateRaw = design.data.Date ?? "";

const year = new Date(design.data.Date).getFullYear();
const shortDate = new Date(design.data.Date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
});
---

<Layout
  type="article"
  article={{
    publishedTime: dateRaw ? new Date(dateRaw).toISOString() : "",
    author: "Eyad Farah",
    section: design.data.Protype,
  }}
  title={`${design.data.title} | Design Portfolio`}
  description={design.data.description}
>
  <main class="max-w-7xl mx-auto px-6 md:px-0 pt-32 pb-20">
    <a
      href="/portfolio/designs"
      class="inline-flex items-center gap-2 mb-12 group font-mono text-[11px] tracking-[0.2em] uppercase text-white/30 hover:text-primary transition-colors"
    >
      <RiArrowLeftLine
        className="group-hover:-translate-x-1 transition-transform"
      />
      Back to Gallery
    </a>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <aside class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col gap-8">
        <div class="bg-white/3 rounded-4xl p-8 border border-white/5">
          <div class="flex flex-wrap gap-2 mb-6">
            <span
              class="px-3 py-1 rounded-full bg-primary text-black font-mono text-[9px] uppercase tracking-widest"
              >{design.data.Protype}</span
            >
            {
              design.data.Unofficial && (
                <span class="px-3 py-1 rounded-full border border-white/10 text-white/50 font-mono text-[9px] uppercase tracking-widest">
                  Unofficial
                </span>
              )
            }
          </div>

          <h1 class="font-bebas uppercase text-6xl leading-[0.9] mb-6">
            {design.data.title}
          </h1>
          <p class="text-white/50 leading-relaxed text-sm mb-8">
            {design.data.description}
          </p>

          <div
            class="pt-6 border-t border-white/5 flex justify-between items-center"
          >
            <span class="font-mono text-[10px] uppercase text-white/20"
              >{shortDate}</span
            >
            <PrimaryBtn
              target={true}
              link={design.data.website}
              text="View Project"
            />
          </div>
        </div>
      </aside>

      <section class="lg:col-span-8 flex flex-col gap-8">
        <div
          class="rounded-4xl overflow-hidden border border-white/5 bg-black/50"
        >
          <Image
            src={design.data.thumbnail}
            widths={[800, 1200]}
            sizes="(max-width: 1024px) 100vw, 800px"
            width={1200}
            height={900}
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto object-cover"
            alt={design.data.title}
          />
        </div>

        <div
          class="rounded-4xl overflow-hidden border border-white/5 bg-neutral-900/20"
        >
          <div
            class="prose prose-invert prose-lg max-w-none
                      prose-headings:font-bebas prose-img:m-0 prose-headings:uppercase"
          >
            <Content />
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
