---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProCard from "@/components/Portfolio/ProCard.astro";
const siteUrl =
  import.meta.env.PUBLIC_DOMAIN_URL || "https://designs-by-eyad.vercel.app";

const desc =
  "Discover my portfolio of brand identity and social media design projects. See how I help Egyptian businesses create compelling online presences.";
const url = "/portfolio/designs";

const designs = await getCollection("design");

const designsProjectsSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "designs Development Portfolio - Designs By Eyad",
  description: desc,
  url: siteUrl + url,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: designs.map((designs, index: number) => ({
      "@type": "ListItem",
      position: index + 1,
      url: siteUrl + designs.id,
      name: designs.data.title,
    })),
  },
});
---
<Layout
  title="Graphic Design Portfolio — Designs By Eyad"
  description={desc}
>
 <main class="relative min-h-screen pt-20 overflow-x-hidden">
    {/* ── Hero ───────────────────────────────────────────────────────── */}
      <section class="max-w-7xl mx-auto px-6 md:px-10 lg:px-0 pt-32 pb-16 border-b border-white/6">
        <div class="flex flex-col gap-8">
          {/* Eyebrow */}
          <div class="flex items-center gap-4">
            <span class="font-mono text-[11px] tracking-[0.15em] text-primary">
              02
            </span>
            <span class="w-8 h-px bg-white/10" />
            <span class="font-mono text-[11px] tracking-[0.15em] uppercase text-white/40">
              Visual Identities
            </span>
          </div>

          {/* Headline */}
          <h1 class="font-['Bebas_Neue',sans-serif] uppercase text-[clamp(72px,13vw,180px)] leading-[0.85] tracking-[-0.01em]">
            Designs<span class="text-primary">.</span>
          </h1>

          {/* Rule + count */}
          <div class="flex items-center gap-6">
            <div class="w-12 h-0.5 bg-primary/40 rounded-full" />
            <span class="font-mono text-[11px] tracking-[0.15em] uppercase text-white/30">
              {designs.length} project{designs.length !== 1 ? "s" : ""}
            </span>
          </div>
        </div>
      </section>

      {/* ── Grid ───────────────────────────────────────────────────────── */}
      <section class="max-w-7xl mx-auto px-6 md:px-10 lg:px-0 py-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {designs.map((design, index) => (
            <div
              class={index === 0 ? "md:col-span-2" : "col-span-1"}
            >
              <ProCard
                projects={design}
                link={"/portfolio/designs/" + design.id}
              />
            </div>
          ))}
        </div>
      </section>

      {/* ── Empty state ────────────────────────────────────────────────── */}
      {designs.length === 0 && (
        <section class="max-w-7xl mx-auto px-6 md:px-10 lg:px-0 py-40 text-center">
          <p class="font-mono text-[11px] tracking-[0.15em] uppercase text-white/25">
            No projects yet — check back soon.
          </p>
        </section>
      )}
 </main>

 <!-- Structured Data -->
  <script type="application/ld+json" set:html={designsProjectsSchema} />
</Layout>