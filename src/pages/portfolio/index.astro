---
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import ProtImages from "@/components/Portfolio/ProtImages.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Portfolio | Designs by Eyad"
  description="Browse my portfolio to see successful brand identity and social media design projects for businesses across Egypt. See how my designs drive engagement and growth."
>
  <main class="min-h-screen pt-24 md:pt-32 pb-16">
    <!-- --- Portfolio Hero Section --- -->
    <section
      class="max-w-7xl mx-auto px-6 lg:px-0 py-16 md:py-24 border-b border-white/10"
    >
      <div class="flex flex-col gap-6">
        <span
          class="font-mono text-[11px] tracking-[0.25em] uppercase text-white/30"
        >
          Showcase
        </span>
        <h1
          class="font-bebas uppercase leading-[0.85] tracking-[-0.01em] text-white"
          style="font-size: clamp(80px, 14vw, 180px);"
        >
          Selected <br />
          <span class="text-primary">Works.</span>
        </h1>
        <p class="text-white/40 text-[15px] max-w-xl leading-relaxed mt-2">
          A curated collection of digital experiences and visual identities
          crafted to help brands stand out in a crowded market.
        </p>
      </div>
    </section>

    <!-- --- Projects Grid Section --- -->
    <section class="max-w-7xl mx-auto px-4 md:px-6 py-20 md:py-32">
      <ProtImages />
    </section>

    <!-- --- Bottom Call to Action --- -->
    <section
      class="max-w-7xl mx-auto px-6 lg:px-12 py-24 text-center border-t border-white/10 flex flex-col items-center"
    >
      <h2
        class="font-bebas uppercase leading-[0.88] tracking-[-0.01em] text-white mb-6"
        style="font-size: clamp(48px, 8vw, 100px);"
      >
        Have a project <br /> in mind?
      </h2>
      <p class="text-white/40 text-[15px] mb-12 max-w-sm mx-auto">
        Let’s collaborate to build something extraordinary together.
      </p>

      <!-- Hard-edged brutalist button to replace the generic CTA -->
      <PrimaryBtn target={false} link={"/contact"} text=" Get In Touch" />
    </section>
  </main></Layout
>
