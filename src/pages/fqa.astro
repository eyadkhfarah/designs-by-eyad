---

<Layout
  title="FAQ | Common Questions — Designs By Eyad"
  description="Find answers to common questions about brand identity, design process, project timelines, and web services in Egypt. Get clarity on how we work together."
>
  <main class="relative min-h-screen overflow-x-hidden">

    <!-- ══════════════════════════════════════════
         § 1  HERO
         ══════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-6 pt-40 pb-28">
      
      <!-- Eyebrow -->
      <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-white/30 mb-10">
        Assistance
      </p>

      <!-- Split-stroke headline to match the brand signature -->
      <h1
        class="font-['Bebas_Neue',sans-serif] uppercase leading-[0.88] tracking-[-0.01em] mb-16"
        style="font-size: clamp(72px, 12vw, 160px);"
      >
        <span class="block text-white">Common</span>
        <span
          class="block"
          style="-webkit-text-stroke: 2px #e5fe00; color: transparent;"
        >
          Questions
        </span>
      </h1>

      <!-- Sub-line + scroll hint row -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 border-t border-white/5 pt-10">
        <p class="text-white/40 text-base leading-relaxed max-w-sm">
          Explore our comprehensive guide to brand identity, web design processes, and project logistics. Everything you need to know before we start creating.
        </p>
        <div class="flex items-center gap-3 text-white/20 shrink-0">
          <span class="text-[10px] font-mono uppercase tracking-[0.2em]">Scroll to read</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden>
            <path d="M8 2v12M3 9l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════
         § 2  FAQ CONTENT
         ══════════════════════════════════════════ -->
    <section class="border-t border-white/5 bg-neutral-900/20">
      <div class="max-w-4xl mx-auto px-6 py-28">
        
        <!-- Replaced the heavy blur box with a cleaner structural container -->
        <div
          class="prose prose-lg prose-invert max-w-none 
                 prose-a:text-primary prose-a:no-underline hover:prose-a:underline 
                 prose-strong:text-white prose-strong:font-bold"
        >
          <FAQCard client:visible />
        </div>

      </div>
    </section>

    <!-- ══════════════════════════════════════════
         § 3  CTA MODULE
         ══════════════════════════════════════════ -->
    <section class="border-t border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-28">
        
        <div class="bg-neutral-900/30 border border-white/5 rounded-4xl p-8 md:p-16 relative overflow-hidden group">
          
          <!-- Subtle layout alignment helper grid background -->
          <div
            aria-hidden="true"
            class="absolute inset-0 opacity-[0.02] pointer-events-none"
            style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 32px 32px;"
          />

          <!-- Ambient blur glowing accent element -->
          <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-primary/10 rounded-full blur-[100px] group-hover:bg-primary/20 transition-all duration-700 pointer-events-none" />

          <div class="flex flex-col md:flex-row items-center md:items-end justify-between gap-12 relative z-10">
            
            <div class="flex flex-col gap-4 text-center md:text-left">
              <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-white/30">
                Still have questions?
              </p>
              <h2 
                class="font-['Bebas_Neue',sans-serif] uppercase leading-[0.88] tracking-[-0.01em] text-white"
                style="font-size: clamp(40px, 6vw, 80px);"
              >
                Ask Me<br />
                <span class="text-primary">Anything</span>
              </h2>
              <p class="text-white/40 text-[15px] leading-relaxed max-w-sm mt-2">
                If your question isn't listed here, feel free to reach out directly.
              </p>
            </div>

            <!-- CTA button (White contrast style for dark sections) -->
            <a
              href="/contact"
              class="group shrink-0 inline-flex items-center gap-4 px-8 py-5 rounded-full bg-white text-black text-[11px] tracking-[0.18em] uppercase font-black hover:bg-neutral-200 active:scale-[0.98] transition-all duration-200"
            >
              Get in touch
              <span
                class="w-8 h-8 rounded-full bg-primary flex items-center justify-center group-hover:translate-x-1 transition-transform duration-200"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden>
                  <path d="M2 7H12M12 7L7 2M12 7L7 12" stroke="black" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>

          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- Structured Data -->
  <!-- <script type="application/ld+json" set:html={fqaSchema} /> -->
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal] {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.55s ease, transform 0.55s ease;
    }
    [data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const els = document.querySelectorAll("section");
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.setAttribute("data-reveal", "");
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.08 }
  );
  els.forEach((el) => {
    el.setAttribute("data-reveal", "");
    io.observe(el);
  });
</script>