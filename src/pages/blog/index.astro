---
import BlogSqr from "@/components/Blog/BlogSqr.astro";
import Layout from "@/layouts/Layout.astro";
import { fetchPosts } from "@/lib/Data/notionBlogData";
import type { NotionBaseProperties } from "@/types/notionType";
import { useTranslations } from "@/utils/i18n";

const t = useTranslations(Astro.currentLocale);
const posts = await fetchPosts();

const postsList: NotionBaseProperties[] = Array.isArray(posts)
  ? posts
  : ((posts as any)?.results ?? []);

const orderedPosts = [...postsList].reverse();
---

<Layout
  title="Blog | Design Insights & Creative Tips"
  description="Expert tips, creative insights, and design trends."
>
  <main class="relative min-h-screen pt-32 pb-20">
    {/* ── Hero Section ──────────────────────────── */}
    <section class="max-w-7xl mx-auto px-6 mb-20">
      <div class="flex flex-col gap-6">
        <span
          class="font-mono text-[10px] tracking-[0.4em] uppercase text-primary"
        >
          002 — Editorial Journal
        </span>
        <h1
          class="font-bebas uppercase text-[clamp(60px,10vw,140px)] leading-[0.85] tracking-tight text-white"
        >
          {t("BlogPage.title")}
        </h1>
        <div class="h-px w-24 bg-white/20 my-4"></div>
        <p
          class="text-white/40 text-[16px] max-w-lg leading-relaxed uppercase tracking-wide"
        >
          Thoughts on design, branding, and the creative process in the digital
          age.
        </p>
      </div>
    </section>

    {/* ── Bento Blog Grid ──────────────────────────── */}
    <section class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          orderedPosts.map((post: any, index: number) => (
            <div
              class={`
            ${index === 0 ? "md:col-span-2 lg:col-span-2" : "col-span-1"}
            rounded-4xl border border-white/5 bg-neutral-900/30 overflow-hidden
          `}
            >
              <BlogSqr post={post} isFeatured={index === 0} index={index} />
            </div>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
