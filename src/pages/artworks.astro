---
import { fetchArtworks } from "@/lib/Data/notionArtworksData";
import ArtworkPrice from "@/components/Pricing/ArtworkPrice.astro";

import Layout from "@/layouts/Layout.astro";
import { useTranslations } from "@/utils/i18n";
import { Image } from "astro:assets";

const t = useTranslations(Astro.currentLocale);

const artworks = await fetchArtworks();
// Ensure we are working with an array of pages
const artworksList = Array.isArray(artworks) ? artworks : [];

const artworkSchema = JSON.stringify(
  artworksList
    .map((artwork: any, i: number) => {
      const name = artwork.properties.Name.title[0]?.plain_text || "Untitled";
      const imageUrl =
        artwork.properties.Image.files[0].external?.url ||
        artwork.properties.Image.files[0].file?.url;
      if (!imageUrl) return null;
      return {
        "@context": "https://schema.org/",
        "@type": "VisualArtwork",
        name: name,
        image: imageUrl,
        creator: {
          "@type": "Person",
          name: "Eyad Farah",
        },
        publisher: {
          "@type": "Organization",
          name: "Designs By Eyad",
        },
      };
    })
    .filter(Boolean),
);
---

<Layout
  title="Artworks | Exclusive Collage Collection — Designs By Eyad"
  description="Explore a captivating collection of unique artwork collages blending creativity and storytelling. Discover handmade designs crafted with intricate details by Eyad Farah."
>
  <main class="relative min-h-screen mt-20 overflow-x-hidden">
    {/* Ambient Top Glow */}
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-100 bg-primary/5 rounded-full blur-[120px] pointer-events-none -z-10"
    >
    </div>

    <section class="max-w-7xl mx-auto lg:px-0 px-6 py-16 md:py-24">
      {/* Editorial Header */}
      <div
        class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8 border-b border-white/10 pb-12"
      >
        <div class="flex flex-col gap-4">
          <span
            class="font-mono text-[11px] tracking-[0.25em] uppercase text-white/30 font-semibold"
          >
            001 — Exclusive Collection
          </span>
          <h1
            class="font-bebas uppercase text-[clamp(60px,10vw,120px)] leading-[0.85] tracking-[-0.01em] text-white drop-shadow-sm"
          >
            Artworks
          </h1>
        </div>
        <p
          class="text-white/40 text-[15px] max-w-sm leading-relaxed mb-2 md:text-right"
        >
          A curated selection of intricate collages blending creativity,
          emotion, and visual storytelling.
        </p>
      </div>

      {/* Modern Gallery Grid */}
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10"
      >
        {
          artworksList.slice(0, 6).map((artwork: any, i: number) => {
            const name =
              artwork.properties?.Name?.title?.[0]?.plain_text || "Untitled";
            const imageUrl =
              artwork.properties?.Image?.files?.[0]?.external?.url ||
              artwork.properties?.Image?.files?.[0]?.file?.url;

            if (!imageUrl) return null;

            return (
              <div class="group relative flex flex-col rounded-[2.5rem] border border-white/5 bg-neutral-900/30 overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.5)] hover:border-white/15">
                {/* Image Container with Zoom & Color Reveal */}
                <div class="relative w-full aspect-4/5 overflow-hidden bg-neutral-950">
                  <Image
                    class="w-full h-full object-cover grayscale opacity-80 transition-all duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0 group-hover:opacity-100"
                    alt={name}
                    src={imageUrl}
                    loading={i < 3 ? "eager" : "lazy"}
                    width={600}
                    height={800}
                  />

                  {/* Subtle vignette gradient to make text readable */}
                  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/10 to-transparent opacity-80" />

                  {/* Floating Index Badge */}
                  <div class="absolute top-6 left-6 px-4 py-1.5 bg-black/40 backdrop-blur-md rounded-full border border-white/10 text-white font-mono text-[10px] tracking-widest">
                    NO. {String(i + 1).padStart(2, "0")}
                  </div>
                </div>

                {/* Content Overlayed at bottom of image */}
                <div class="absolute bottom-0 left-0 w-full p-8 flex justify-between items-end gap-4">
                  <div>
                    <h3 class="font-bebas text-3xl md:text-4xl uppercase text-white tracking-wide group-hover:text-primary transition-colors duration-300 drop-shadow-md">
                      {name}
                    </h3>
                  </div>

                  {/* Circular Action Button */}
                  <div class="w-10 h-10 shrink-0 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20 group-hover:bg-primary group-hover:text-black group-hover:border-primary transition-all duration-300">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    {/* The Redesigned Pricing Component fits perfectly here */}
    <ArtworkPrice />
  </main>

  <!-- Structured Data -->
  <script
    id="artwork-schema"
    type="application/ld+json"
    set:html={artworkSchema}
  />
</Layout>
