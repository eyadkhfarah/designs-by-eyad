---
import Layout from "@/layouts/Layout.astro";
import ContactList from "@/components/Email/ContactList.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "Contact | Let's Work Together — Designs By Eyad",
  description = "Get in touch with Eyad Farah, a graphic designer and creative director based in Aswan, Egypt. Available for brand identity, social media design, UI/UX, and web development projects.",
} = Astro.props;
---

<Layout
  title={title}
  description={description}
>
  <main class="min-h-screen relative overflow-x-hidden">
    <!-- ══════════════════════════════════════════
         HERO — Split-rule headline
    ══════════════════════════════════════════ -->
    <header class="max-w-7xl mx-auto px-6 pt-36 pb-0">
      <p
        class="font-mono text-[10px] tracking-[0.35em] uppercase text-white/25 mb-8"
      >
        Designs By Eyad — Let's talk
      </p>

      <div class="relative mb-0">
        <!-- Line 1: solid -->
        <p
          aria-hidden="true"
          class="font-['Bebas_Neue',sans-serif] uppercase leading-[0.88] tracking-[-0.01em] text-white block"
          style="font-size: clamp(72px, 14vw, 172px);"
        >
          Get In
        </p>

        <!-- Rule between lines -->
        <div class="relative h-px my-3">
          <div class="absolute inset-0 bg-white/5"></div>
          <div
            class="absolute left-0 top-0 h-px bg-primary"
            style="width: clamp(80px, 12vw, 140px);"
          >
          </div>
        </div>

        <!-- Line 2: stroke only -->
        <h1
          class="font-['Bebas_Neue',sans-serif] uppercase leading-[0.88] tracking-[-0.01em] block"
          style="font-size: clamp(72px, 14vw, 172px); -webkit-text-stroke: 2px rgba(255,255,255,0.15); color: transparent;"
        >
          Touch
        </h1>
      </div>

      <div class="border-t border-white/5 mt-16"></div>
    </header>

    <!-- ══════════════════════════════════════════
         BODY — Sidebar + Form
    ══════════════════════════════════════════ -->
    <section class="max-w-7xl mx-auto px-6 py-16 pb-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-0 lg:gap-20 items-start">
        <!-- Sidebar -->
        <aside
          class="lg:col-span-4 order-2 lg:order-1 min-w-0 lg:sticky lg:top-36"
        >
          <p class="text-white/35 text-[15px] leading-relaxed mb-12 max-w-xs">
            Based in Aswan, Egypt. Working with brands across the region and
            beyond.
          </p>

          <div class="border-t border-white/5">
            <ContactList />
          </div>

          <div class="mt-12 flex items-center gap-3">
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
              ></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"
              ></span>
            </span>
            <span
              class="text-[11px] font-mono uppercase tracking-[0.2em] text-white/30"
            >
              Available for new projects
            </span>
          </div>
        </aside>

        <!-- Vertical divider -->
        <div
          class="hidden lg:block lg:col-span-0 absolute left-1/3 top-0 bottom-0 w-px bg-white/5 pointer-events-none"
          aria-hidden="true"
        >
        </div>

        <!-- Form slot -->
        <div class="lg:col-span-8 order-1 lg:order-2 min-w-0">
          <slot />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    header p[aria-hidden],
    header h1,
    header .border-t {
      opacity: 0;
      transform: translateY(16px);
    }

    header p[aria-hidden] {
      animation: fade-up 0.5s ease 0.05s forwards;
    }
    header h1 {
      animation: fade-up 0.5s ease 0.2s forwards;
    }
    header .border-t {
      animation: fade-up 0.4s ease 0.35s forwards;
    }

    @keyframes fade-up {
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
