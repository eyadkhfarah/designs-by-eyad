---
import { nonindesxList as nonIndexList } from "@/lib/nonindexList";
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import { useTranslations } from "@/utils/i18n";
import { Image } from "astro:assets";
import { NavListLang } from "@/lib/NavList";
import SocialLinks from "./Navbar/SocialLinks.astro";
import { RiArrowRightLine } from "@remixicon/react";

const t = useTranslations(Astro.currentLocale);

const navItems = NavListLang.filter((nav) => nav.link !== "/contact");
const year = new Date().getFullYear();
---

<!-- ══════════════════════════════════════════
       PRE-FOOTER CTA — full bleed yellow
  ══════════════════════════════════════════ -->
<section class="relative overflow-hidden bg-primary">
  <!-- Grid texture -->
  <div
    aria-hidden="true"
    class="absolute inset-0 opacity-[0.06] pointer-events-none"
    style="background-image: linear-gradient(rgba(0,0,0,1) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,1) 1px, transparent 1px); background-size: 48px 48px;"
  >
  </div>

  <!-- Ghost word -->
  <p
    aria-hidden="true"
    class="absolute -bottom-6 right-0 font-['Bebas_Neue',sans-serif] uppercase
             leading-none text-black/8 pointer-events-none select-none whitespace-nowrap"
    style="font-size: clamp(80px, 18vw, 220px);"
  >
    {t("Footer.Header.contact")}
  </p>

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 py-20 md:py-28
                flex flex-col md:flex-row items-start md:items-end
                justify-between gap-10"
  >
    <!-- Copy -->
    <div class="flex flex-col gap-4 max-w-xl">
      <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-black/40">
        Let's build something
      </p>
      <h2
        class="font-['Bebas_Neue',sans-serif] uppercase leading-[0.88]
                 tracking-[-0.01em] text-black"
        style="font-size: clamp(48px, 8vw, 100px);"
      >
        {t("Footer.Header.title")}
      </h2>
      <p class="text-black/55 text-[15px] leading-relaxed">
        {t("Footer.Header.subtitle")}
      </p>
    </div>

    <!-- CTA -->
    <a
      href="/contact"
      class="group shrink-0 inline-flex items-center gap-4
               px-8 py-5 rounded-full
               bg-black text-white font-black text-[11px]
               uppercase tracking-[0.18em]
               hover:bg-neutral-900 active:scale-[0.98]
               transition-all duration-200"
    >
      {t("Footer.Header.contact")}
      <span
        class="w-8 h-8 p-1 rounded-full text-background bg-primary flex items-center justify-center
                     group-hover:translate-x-1 transition-transform duration-200"
      >
        <RiArrowRightLine />
      </span>
    </a>
  </div>
</section>

<!-- ══════════════════════════════════════════
       MAIN FOOTER
  ══════════════════════════════════════════ -->
<footer class="bg-[#060606] border-t m-0 border-white/5">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <!-- Top grid: logo / nav / social -->
    <div
      class="grid grid-cols-1 md:grid-cols-[1fr_auto_auto] gap-12 md:gap-20 pb-12 border-b border-white/5"
    >
      <!-- Logo + tagline -->
      <div class="flex flex-col gap-6">
        <a
          href="/"
          aria-label="Designs By Eyad — Home"
          class="flex items-end gap-3 group w-fit"
        >
          <Image
            alt="Designs By Eyad Logo"
            src="/logo.svg"
            loading="lazy"
            width={20}
            height={20}
          />
          <span class="font-bold uppercase text-base/1 h-fit">
            Designs<br />
            <span
              class="text-xl group-hover:text-primary transition-colors duration-300"
            >
              By Eyad
            </span>
          </span>
        </a>

        <p class="text-white/25 text-[13px] leading-relaxed max-w-55">
          Brand identity & visual design studio — Aswan, Egypt.
        </p>

        <!-- Availability -->
        <div class="flex items-center gap-2">
          <span class="relative flex h-1.5 w-1.5">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"
            ></span>
          </span>
          <span
            class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/25"
          >
            Available for projects
          </span>
        </div>
      </div>

      <!-- Nav links -->
      <div class="flex flex-col gap-4">
        <p
          class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/20 mb-2"
        >
          Navigate
        </p>
        <ul class="flex flex-col gap-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.link}
                  class="text-[13px] font-bold uppercase tracking-widest
                         text-white/40 hover:text-primary
                         transition-colors duration-200"
                >
                  {t(item.translationKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Social -->
      <div class="flex flex-col gap-4">
        <p
          class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/20 mb-2"
        >
          Follow
        </p>
        <!-- column layout for footer sidebar -->
        <SocialLinks variant="column" />
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8"
    >
      <!-- Copyright -->
      <p
        class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/15 order-2 md:order-1"
      >
        © {year} Designs by Eyad — {t("Footer.copyright")}
      </p>

      <!-- Legal links -->
      <ul class="flex items-center gap-6 order-1 md:order-2">
        {
          nonIndexList.map((link) => (
            <li>
              <a
                href={link.link}
                class="font-mono text-[10px] uppercase tracking-[0.2em]
                       text-white/15 hover:text-white/40
                       transition-colors duration-200"
              >
                {t(link.name)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
