---
import { Image } from "astro:assets";
import NavMenu from "./Navbar/NavMenu.astro";
import NavMobile from "./Navbar/NavMobile.astro";
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <!-- The bar itself -->
  <nav
    class="relative w-full
           px-6 md:px-10 py-3 md:py-3
           border-b border-transparent
           transition-[background-color,border-color,backdrop-filter] duration-500"
    id="nav-bar"
    aria-label="Main navigation"
  >
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <!-- ── Logo (unchanged per brief) ──────────────────────────────── -->
      <a
        href="/"
        aria-label="Designs By Eyad — Home"
        class="flex items-end gap-3 group shrink-0 z-10"
      >
        <Image
          alt="Designs By Eyad Logo"
          src="/logo.svg"
          loading="eager"
          width={20}
          height={20}
        />
        <span class="font-bold uppercase text-base/1 h-fit">
          Designs
          <br />
          <span
            class="text-xl group-hover:text-primary transition ease-in-out duration-300"
          >
            By Eyad
          </span>
        </span>
      </a>

      <!-- ── Desktop menu ─────────────────────────────────────────────── -->
      <div class="hidden lg:flex items-center">
        <NavMenu />
      </div>

      <!-- ── Burger — typographic, not iconic ────────────────────────── -->
      <button
        id="menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="lg:hidden flex items-center gap-2 group focus-visible:outline-2 focus-visible:outline-primary"
      >
        <!-- Animated lines -->
        <span class="flex flex-col gap-1.25" aria-hidden="true">
          <span
            id="burger-top"
            class="block h-px w-5 bg-white transition-all duration-300 origin-center"
          ></span>
          <span
            id="burger-mid"
            class="block h-px w-3 bg-primary transition-all duration-300"
          ></span>
          <span
            id="burger-bot"
            class="block h-px w-5 bg-white transition-all duration-300 origin-center"
          ></span>
        </span>
        <span
          id="burger-label"
          class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/40
               group-hover:text-primary transition-colors duration-200"
        >
          Menu
        </span>
      </button>

      <!-- Scroll progress line -->
      <div
        id="scroll-progress"
        aria-hidden="true"
        class="absolute bottom-0 left-0 h-px bg-primary origin-left scale-x-0
             transition-none pointer-events-none"
      >
      </div>
    </div>
  </nav>
</header>

<NavMobile />

<style>
  /* Scrolled state applied via JS */
  #nav-bar.scrolled {
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-color: rgba(255, 255, 255, 0.06);
  }

  /* Burger open state */
  #menu-toggle[aria-expanded="true"] #burger-top {
    transform: translateY(6px) rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] #burger-mid {
    opacity: 0;
    transform: scaleX(0);
  }
  #menu-toggle[aria-expanded="true"] #burger-bot {
    transform: translateY(-6px) rotate(-45deg);
  }
  #menu-toggle[aria-expanded="true"] #burger-label {
    color: rgb(229 254 0 / 0.6);
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
  const navBar = document.getElementById("nav-bar") as HTMLElement;
  const progress = document.getElementById("scroll-progress") as HTMLElement;

  // ── Scroll: background + progress bar ──────────────────────────────
  function onScroll() {
    const scrolled = window.scrollY > 20;
    navBar.classList.toggle("scrolled", scrolled);

    // Progress bar
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docH > 0 ? window.scrollY / docH : 0;
    progress.style.transform = `scaleX(${pct})`;
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll(); // sync on load

  // ── Burger toggle ───────────────────────────────────────────────────
  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";

    if (isOpen) {
      toggle.setAttribute("aria-expanded", "false");
      document.dispatchEvent(new CustomEvent("close-mobile-nav"));
    } else {
      toggle.setAttribute("aria-expanded", "true");
      document.dispatchEvent(new CustomEvent("open-mobile-nav"));
    }
  });

  // Reset burger when nav closes from inside (Escape / link click)
  document.addEventListener("close-mobile-nav", () => {
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>
