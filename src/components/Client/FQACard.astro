---
import { marked } from "marked";
import faqData from "@/lib/faqData";

interface FAQItem {
  question: string;
  answer: string;
}

const faqs: FAQItem[] = faqData as FAQItem[];
---

<div class="flex flex-col w-full border-t border-white/5" id="faq-accordion">
  {
    faqs.map((item) => (
      <div class="faq-item border-b border-white/5">
        <button
          class="faq-button w-full cursor-pointer flex justify-between items-center py-8 text-left group"
          aria-expanded="false"
        >
          <span class="faq-title font-bebas uppercase leading-[1.1] tracking-[0.02em] text-2xl md:text-4xl text-white/80 transition-colors duration-300 group-hover:text-white">
            {item.question}
          </span>

          <div class="faq-icon-wrapper shrink-0 flex items-center justify-center w-12 h-12 rounded-full border border-white/10 transition-all duration-500 group-hover:border-primary/50">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              class="faq-icon w-6 h-6 text-white/40 transition-colors duration-500 group-hover:text-primary"
            >
              <path d="M13 16.1716L18.364 10.8076L19.7782 12.2218L12 20L4.22183 12.2218L5.63604 10.8076L11 16.1716V4H13V16.1716Z" />
            </svg>
          </div>
        </button>

        <div class="faq-content">
          <div class="overflow-hidden">
            <div
              class="pb-8 pr-12 md:pr-24 pt-2 text-white/45 leading-relaxed text-lg"
              set:html={marked(item.answer)}
            />
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.4s ease, opacity 0.4s ease;
  }

  .faq-item.is-open .faq-content {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* Using standard CSS property colors instead of @apply */
  .faq-item.is-open .faq-title {
    color: var(--color-primary, #e5fe00); 
  }

  .faq-item.is-open .faq-icon-wrapper {
    background-color: var(--color-primary, #e5fe00);
    border-color: var(--color-primary, #e5fe00);
    transform: rotate(180deg);
  }

  .faq-item.is-open .faq-icon {
    color: black;
  }
</style>

<script>
  function setupAccordion() {
    const accordion = document.getElementById("faq-accordion");
    
    // Check if the element exists - if this logs "Accordion not found", your HTML ID is wrong
    if (!accordion) {
      console.error("Accordion not found! Check your HTML ID.");
      return;
    }

    // Remove any existing listeners to prevent duplication
    accordion.removeEventListener("click", handleAccordionClick);
    accordion.addEventListener("click", handleAccordionClick);
  }

  function handleAccordionClick(e: Event) {
    const target = e.target as HTMLElement;
    const button = target.closest(".faq-button");
    if (!button) return;

    const currentItem = button.closest(".faq-item");
    if (!currentItem) return;

    const isOpen = currentItem.classList.contains("is-open");

    // Close all other items
    document.querySelectorAll(".faq-item").forEach((item) => {
      item.classList.remove("is-open");
      item.querySelector("button")?.setAttribute("aria-expanded", "false");
    });

    // Toggle current item
    if (!isOpen) {
      currentItem.classList.add("is-open");
      button.setAttribute("aria-expanded", "true");
    }
  }

  // Use both listeners to cover all bases
  document.addEventListener("astro:page-load", setupAccordion);
  setupAccordion(); // Initial run
</script>