---
import { useTranslations } from "@/utils/i18n";

interface Props {
  locale?: string | undefined;
}

const { locale } = Astro.props;
const t = useTranslations(locale ?? Astro.currentLocale);

const items = [
  {
    label:      "Mission",
    headingKey: "AboutPage.MissionAndVision.Mission.title",
    contentKey: "AboutPage.MissionAndVision.Mission.subtitle",
    path: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    label:      "Vision",
    headingKey: "AboutPage.MissionAndVision.Vision.title",
    contentKey: "AboutPage.MissionAndVision.Vision.subtitle",
    paths: [
      "M15 12a3 3 0 11-6 0 3 3 0 016 0z",
      "M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
    ],
  },
] as const;
---

<div class="mv-root w-full">
  <div class="grid grid-cols-1 lg:grid-cols-2 divide-y lg:divide-y-0 lg:divide-x divide-white/5">

    {items.map((item, i) => (
      <div
        class:list={[
          "mv-col group relative flex flex-col gap-8 px-0 py-10",
          i === 0 ? "lg:pr-16" : "lg:pl-16",
        ]}
      >
        <!-- Ghost label — stroke only, bleeds at top -->
        <p
          aria-hidden="true"
          class="font-bebas uppercase leading-none
                 select-none pointer-events-none mb-0"
          style={`
            font-size: clamp(64px, 10vw, 120px);
            -webkit-text-stroke: 1px rgba(255,255,255,0.07);
            color: transparent;
            letter-spacing: -0.01em;
          `}
        >
          {item.label}
        </p>

        <!-- Yellow tick + translated heading -->
        <div class="flex items-start gap-5 -mt-4">
          <!-- Icon in minimal circle -->
          <div class="shrink-0 mt-1 w-10 h-10 rounded-full border border-white/10
                      flex items-center justify-center text-primary
                      group-hover:border-primary/40 transition-colors duration-300">
            <svg class="w-4 h-4" fill="none" stroke="currentColor"
                 viewBox="0 0 24 24" aria-hidden="true">
              {"path" in item ? (
                <path stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="1.5" d={item.path} />
              ) : item.paths.map((d) => (
                <path stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="1.5" d={d} />
              ))}
            </svg>
          </div>

          <div class="flex flex-col gap-4">
            <h3
              class="font-bebas uppercase leading-[0.9]
                     tracking-[-0.01em] text-white"
              style="font-size: clamp(32px, 4vw, 48px);"
            >
              {t(item.headingKey)}
            </h3>

            <!-- Primary accent bar — slides in on scroll -->
            <div class="mv-bar h-px bg-primary origin-left scale-x-0
                        transition-transform duration-700 ease-out"
                 style={`width: clamp(40px, 6vw, 80px);`}
            />
          </div>
        </div>

        <!-- Body -->
        <p class="text-white/40 text-[15px] leading-[1.85]
                  group-hover:text-white/60 transition-colors duration-300
                  max-w-md">
          {t(item.contentKey)}
        </p>

        <!-- Bottom label — index marker -->
        <p class="mt-auto font-mono text-[9px] uppercase tracking-[0.35em] text-white/15">
          {String(i + 1).padStart(2, "0")} / {String(items.length).padStart(2, "0")}
        </p>
      </div>
    ))}
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .mv-col {
      opacity: 0;
      transform: translateY(20px);
      transition:
        opacity   0.65s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mv-col:nth-child(2) {
      transition-delay: 0.15s;
    }

    .mv-col.is-visible {
      opacity: 1;
      transform: none;
    }

    /* Accent bar draws in after column is visible */
    .mv-col.is-visible .mv-bar {
      transform: scaleX(1);
      transition-delay: 0.4s;
    }
  }
</style>

<script>
  const cols = document.querySelectorAll<HTMLElement>(".mv-col");

  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("is-visible");
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.2, rootMargin: "-60px 0px" },
  );

  cols.forEach((c) => io.observe(c));
</script>