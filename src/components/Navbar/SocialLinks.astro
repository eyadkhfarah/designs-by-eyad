---
// src/components/SocialLinks.astro
import { socialLinks } from "@/lib/socialLinks";
import { RiArrowRightSLine } from "@remixicon/react";

interface Props {
  /** visual variant */
  variant?: "row" | "column";
  class?: string;
}

const { variant = "row", class: className = "" } = Astro.props;
---

<ul
  class:list={[
    "flex gap-3",
    variant === "column" ? "flex-col" : "flex-row flex-wrap",
    className,
  ]}
>
  {
    socialLinks.map((s) => {
      const Icon = s.icon;
      return (
        <li>
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="group flex items-center gap-3
                 text-white/30 hover:text-primary
                 transition-colors duration-200"
          >
            <span
              class="shrink-0 text-lg text-white/20
                       group-hover:text-primary transition-colors duration-200"
            >
              <Icon />
            </span>

            {variant === "column" && (
              <>
                <span class="text-[13px] font-bold uppercase tracking-widest">
                  {s.label}
                </span>
                <RiArrowRightSLine
                  className="w-3.5 h-3.5 ml-auto opacity-0 -translate-x-1
                       group-hover:opacity-100 group-hover:translate-x-0
                       transition-all duration-200 shrink-0"
                />
              </>
            )}
          </a>
        </li>
      );
    })
  }
</ul>
