---
import { RiArrowRightSLine } from "@remixicon/react";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"web"> | CollectionEntry<"design">;
  link: string;
  eager?: boolean;
}

const { projects, link, eager = false } = Astro.props;

const isWeb = projects.collection === "web";
const isDesign = projects.collection === "design";
const bgColor = isDesign ? (projects as CollectionEntry<"design">).data.BGColor : null;

const formattedDate = new Date(projects.data.Date).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<a
  href={link}
  class="group block w-full focus-visible:outline-2 focus-visible:outline-primary"
  aria-label={projects.data.title}
>
  <article
    class="relative flex flex-col lg:flex-row gap-6 p-5 rounded-4xl border border-white/5 bg-neutral-900/40 hover:bg-neutral-900/70 hover:border-primary/20 transition-colors duration-400 overflow-hidden will-change-transform"
  >
    {bgColor && (
      <div
        class="absolute left-0 top-4 bottom-4 w-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        style={`background-color: ${bgColor};`}
      />
    )}

    <div class="relative shrink-0 w-full lg:w-44 aspect-square overflow-hidden rounded-[1.25rem] bg-neutral-950">
      <Image
        src={projects.data.thumbnail}
        alt={projects.data.title}
        width={352}
        height={352}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
        fetchpriority={eager ? "high" : "auto"}
        class="w-full h-full object-cover transition-transform duration-600 ease-out group-hover:scale-105"
      />

      <div class="absolute bottom-3 left-3 pointer-events-none">
        <span class="bg-primary text-black font-black text-[8px] uppercase tracking-[0.2em] px-2.5 py-1 rounded-full">
          {projects.data.Protype}
        </span>
      </div>
    </div>

    <div class="flex flex-col justify-between grow py-1 min-w-0">
      <div class="flex flex-col gap-2">
        <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/25">
          {isWeb ? "Web Development" : "Graphic Design"}
        </span>

        <h2 class="font-bebas uppercase leading-[0.9] tracking-[-0.01em] text-white line-clamp-1 group-hover:text-primary transition-colors duration-300" style="font-size: clamp(26px, 3.5vw, 38px);">
          {projects.data.title}
        </h2>

        <p class="text-white/35 text-[13px] leading-relaxed line-clamp-2 max-w-xl">
          {projects.data.description}
        </p>
      </div>

      <footer class="flex items-center justify-between mt-6 pt-4 border-t border-white/5">
        <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/20">
          {formattedDate}
        </span>

        <span class="inline-flex items-center gap-2 font-black text-[10px] uppercase tracking-[0.2em] text-white/20 group-hover:text-primary transition-colors duration-300">
          View
          <RiArrowRightSLine className="w-3 h-3 -translate-x-1 group-hover:translate-x-0 transition-transform duration-300" />
        </span>
      </footer>
    </div>
  </article>
</a>