---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";

// 1. Statically import images from your src folder to enable build-time optimization.
// Note: Move these images from /public to /src/assets/ if they aren't there already.
import codingImg from "@/assets/coding.webp";
import designImg from "@/assets/design.webp";

// Define strict types to ensure type safety
interface Section {
  eyebrow: string;
  heading: string;
  accent: string;
  body: string;
  link: string;
  cta: string;
  image: ImageMetadata; // Requires an imported image object, not a string
  imageAlt: string;
  reverse: boolean;
}

const sections: Section[] = [
  {
    eyebrow: "Digital Experience",
    heading: "Colorful",
    accent: "Web",
    body: "Websites built with vibrant color, seamless transitions, and modern typography — tailored for brands that refuse to be invisible.",
    link: "/portfolio/web",
    cta: "Check My Websites",
    image: codingImg,
    imageAlt: "Web Development Showcase",
    reverse: false,
  },
  {
    eyebrow: "Visual Identity",
    heading: "Branding",
    accent: "Brilliance",
    body: "Minimalist systems that carry maximum weight — timeless visual frameworks built to resonate and outlast trends.",
    link: "/portfolio/designs",
    cta: "Check My Designs",
    image: designImg,
    imageAlt: "Brand Identity Showcase",
    reverse: true,
  },
];
---

<div class="flex flex-col w-full gap-24 md:gap-40 py-10">
  {
    sections.map((s, index) => (
      <div
        class:list={[
          "reveal-row",
          "flex flex-col items-center justify-between gap-12 group",
          s.reverse ? "lg:flex-row-reverse" : "lg:flex-row",
        ]}
      >
        <div
          class:list={[
            "reveal-img",
            "relative overflow-hidden border border-white/8 bg-neutral-900/50",
            "aspect-square lg:w-1/2 w-full rounded-[2.5rem]",
          ]}
        >
          <div
            aria-hidden="true"
            class="absolute inset-0 opacity-[0.07] pointer-events-none z-10"
            style="background-image: linear-gradient(rgba(255,255,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,1) 1px, transparent 1px); background-size: 32px 32px;"
          />

          <Image
            alt={s.imageAlt}
            src={s.image}
            width={600}
            height={600}
            loading={index === 0 ? "eager" : "lazy"}
            decoding={index === 0 ? "sync" : "async"}
            class="group-hover:scale-105 group-hover:opacity-75 transition-all duration-700 ease-out aspect-square object-cover w-full h-full relative z-0"
          />

          <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent z-10 pointer-events-none" />

          <div class="absolute bottom-6 left-6 z-20">
            <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/30">
              {s.eyebrow}
            </span>
          </div>
        </div>

        <div
          class:list={[
            "reveal-text",
            "lg:w-1/2 flex flex-col gap-8",
            s.reverse ? "lg:pr-12" : "lg:pl-12",
          ]}
        >
          <div class="flex flex-col gap-5">
            <div class="flex items-center gap-4">
              <span class="w-6 h-px bg-primary" />
              <span class="font-mono text-[10px] tracking-[0.3em] uppercase text-white/30">
                {s.eyebrow}
              </span>
            </div>

            <h2
              class="font-bebas uppercase leading-[0.88] tracking-[-0.01em] text-white"
              style="font-size: clamp(52px, 8vw, 100px);"
            >
              {s.heading}
              <br />
              <span style="-webkit-text-stroke: 1.5px #e5fe00; color: transparent;">
                {s.accent}
              </span>
            </h2>

            <p class="text-white/40 text-[15px] leading-relaxed max-w-sm border-l border-white/8 pl-5">
              {s.body}
            </p>
          </div>

          <PrimaryBtn target={false} link={s.link} text={s.cta} />
        </div>
      </div>
    ))
  }
</div>

<style>
  /* 1. Initial hidden state */
  .reveal-img,
  .reveal-text {
    opacity: 0;
    transform: translateY(28px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 2. The class that triggers the animation */
  .reveal-row.is-visible .reveal-img,
  .reveal-row.is-visible .reveal-text {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }
</style>

<script>
  const triggerAnimations = () => {
    const rows = document.querySelectorAll(".reveal-row");

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -10% 0px" }
    );

    rows.forEach((row) => io.observe(row));
  };

  // Run on first load
  triggerAnimations();

  // Run again if using View Transitions
  document.addEventListener("astro:page-load", triggerAnimations);
</script>
