---
import { RiCheckLine } from "@remixicon/react";
import PrimaryBtn from "@/components/Buttons/PrimaryBtn.astro";
import { plans } from "@/lib/Prices";
import { useTranslations } from "@/utils/i18n";

interface Props {
  locale?: string | undefined;
}

const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
---

<section class="py-20 max-w-7xl mx-auto px-6 lg:px-0 relative overflow-hidden">
  {/* Optional ambient background glow for that modern SaaS feel */}
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-125 bg-primary/5 rounded-full blur-[120px] pointer-events-none -z-10"
  >
  </div>

  <div class="container mx-auto">
    {/* Header */}
    <header
      class="mb-20 flex flex-col md:flex-row justify-between items-end gap-12 border-b border-white/10 pb-12"
    >
      <div class="flex flex-col gap-4">
        <span
          class="font-mono text-[11px] tracking-[0.25em] uppercase text-white/30 font-semibold"
        >
          Pricing Structure
        </span>
        <h2
          class="font-bebas uppercase text-[clamp(48px,8vw,80px)] leading-[0.85] tracking-[-0.01em] text-white drop-shadow-sm"
        >
          {t("ArtworkPrice.title")}
        </h2>
      </div>
      <p class="text-white/50 text-[15px] max-w-sm leading-relaxed">
        {t("ArtworkPrice.subtitle")}
      </p>
    </header>

    {
      /* Pricing Grid - Converted to separated cards for a cleaner, modern look */
    }
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      {
        plans.map(
          (
            plan: {
              title: string;
              description: string;
              price: string;
              features: string[];
            },
            index: number,
          ) => {
            const isHighlighted = index === 1;

            return (
              <div
                class:list={[
                  "group relative flex flex-col p-10 md:p-14 rounded-[2.5rem] border backdrop-blur-md transition-all duration-500 ease-out hover:-translate-y-2",
                  isHighlighted
                    ? "bg-white/3 border-primary/30 shadow-[0_0_40px_-15px_rgba(229,254,0,0.15)] hover:border-primary/50"
                    : "bg-neutral-900/40 border-white/5 hover:border-white/15 hover:bg-neutral-900/60",
                ]}
              >
                {isHighlighted && (
                  <div class="absolute -top-4 right-10 px-5 py-2 bg-primary text-black font-mono text-[11px] uppercase tracking-widest rounded-full shadow-[0_5px_20px_-5px_rgba(229,254,0,0.4)]">
                    Best Value
                  </div>
                )}

                <div class="mb-10">
                  <h3 class="font-bebas uppercase text-4xl text-white mb-3 tracking-wide">
                    {t(plan.title)}
                  </h3>
                  <p class="text-white/40 text-[14px] leading-relaxed">
                    {t(plan.description)}
                  </p>
                </div>

                <div class="mb-12 pb-12 border-b border-white/10">
                  <span class="text-6xl font-bold text-white tracking-tighter drop-shadow-md">
                    {plan.price}
                  </span>
                </div>

                <div class="grow mb-14">
                  <ul class="space-y-5">
                    {plan.features.map((feature: string) => (
                      <li class="flex items-start gap-4">
                        <div class="mt-0.5">
                          <RiCheckLine
                            size={20}
                            className={
                              isHighlighted
                                ? "text-primary"
                                : "text-white/30 group-hover:text-white/50 transition-colors"
                            }
                          />
                        </div>
                        <span class="text-white/70 text-[15px] leading-tight font-mono tracking-tight">
                          {t(feature)}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="mt-auto">
                  <PrimaryBtn
                    target={false}
                    link="/contact"
                    text={t("ArtworkPrice.CTA")}
                    className={
                      isHighlighted
                        ? "w-full"
                        : "w-full opacity-80 hover:opacity-100"
                    }
                  />
                </div>
              </div>
            );
          },
        )
      }
    </div>

    <footer class="mt-20 text-center">
      <p
        class="font-mono text-[12px] uppercase tracking-[0.2em] text-white/30 italic"
      >
        {t("ArtworkPrice.Note")}
      </p>
    </footer>
  </div>
</section>
