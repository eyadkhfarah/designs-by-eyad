---
import { Image } from 'astro:assets';
import { IconCalendarTime } from '@tabler/icons-react';
import { getNotionFileUrl, type NotionProps } from '@/types/notionType';

interface Props extends NotionProps {
  isFeatured?: boolean;
  index: number
}

const { post, isFeatured = false, index } = Astro.props;

const title = post.properties.Name.title[0]?.plain_text ?? "Untitled Post";
const slug = post.properties.Slug.rich_text[0]?.plain_text;
const subtitle = post.properties.Subtitle.rich_text[0]?.plain_text;
const category = post.properties.Category.select?.name;
const date = post.properties.Publication.date?.start;

const thumbnailFile = post.properties.Thumbnail?.files?.[0];
const imageUrl = thumbnailFile
  ? getNotionFileUrl(thumbnailFile)
  : "/placeholder.jpg";

const formattedDate = date ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : null;
---

<a 
  href={`/blog/${slug}`}
  class="group flex flex-col h-full bg-neutral-900/30 transition-colors duration-500 hover:bg-white/5"
>
  {/* Thumbnail */}
  <div class="relative overflow-hidden aspect-16/10 border-b border-white/10">
    <Image
      class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
      alt={title}
      src={imageUrl}
      width={1200}
      height={800}
      loading={isFeatured || index == 1 ? "eager" : "lazy"}
    />

    {/* Category Label */}
    {category && (
      <div class="absolute top-0 left-0 bg-primary text-black px-4 py-1 font-mono text-[10px] uppercase tracking-widest">
        {category}
      </div>
    )}
  </div>

  {/* Content */}
  <div class="flex flex-col p-8 grow gap-6">
    <div class="flex flex-col gap-2">
      {formattedDate && (
        <div class="flex items-center gap-2 text-white/20 text-[10px] font-mono uppercase tracking-[0.2em]">
          <IconCalendarTime size={14} />
          {formattedDate}
        </div>
      )}

      <h2 class={`font-['Bebas_Neue',sans-serif] uppercase leading-[0.9] text-white group-hover:text-primary transition-colors ${isFeatured ? "text-5xl" : "text-3xl"}`}>
        {title}
      </h2>
    </div>

    {subtitle && (
      <p class="text-white/40 text-[14px] leading-relaxed line-clamp-3 font-mono">
        {subtitle}
      </p>
    )}

    <div class="mt-auto pt-6 border-t border-white/5">
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/30 group-hover:text-primary transition-colors">
        Read Entry //
      </span>
    </div>
  </div>
</a>