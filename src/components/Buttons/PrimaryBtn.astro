---
import { RiBehanceFill } from "@remixicon/react";

interface Props {
  link: string;
  text: string;
  target?: boolean;
  className?: string;
  icon?: any;
}

const {
  link,
  text,
  target = false,
  className = "",
  icon: CustomIcon,
} = Astro.props;
const isBehance = text.toLowerCase().includes("behance");
---

<a
  href={link}
  target={target ? "_blank" : "_self"}
  class:list={[
    "inline-flex w-fit items-center justify-center gap-3 px-10 py-4 bg-neutral-950 text-white border-2 border-primary rounded-full font-bold uppercase tracking-widest text-[12px] hover:bg-primary hover:text-black transition-all duration-300 group",
    className,
  ]}
>
  {
    CustomIcon ? (
      <CustomIcon className="w-4 h-4" />
    ) : isBehance ? (
      <RiBehanceFill className="w-4 h-4" />
    ) : null
  }
  {text}
</a>
